# Template konfigurasi PaketVault
# Salin file ini ke .env dan isi nilainya

# Supabase — dapatkan dari: Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Storage bucket name (buat di: Storage → New Bucket, type: Private)
STORAGE_BUCKET=delivery-photos

# API URL (opsional)
API_URL=
